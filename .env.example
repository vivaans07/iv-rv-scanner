# Copy to .env and fill in. .env is gitignored.

# Optional: FRED API key for the 3-month T-bill rate. Falls back to
# settings.yaml rates.fallback_rate when empty.
FRED_API_KEY=

# Data provider: yfinance (default, no key), tradier, polygon
VOLSCAN_PROVIDER=yfinance
TRADIER_API_KEY=
POLYGON_API_KEY=

# Optional overrides for local paths (relative to project root by default)
VOLSCAN_DB_PATH=data/volscan.duckdb
VOLSCAN_REPORT_DIR=reports/output
VOLSCAN_LOG_DIR=logs
